# Managed by Ansible. Do not edit — changes will be overwritten on next deployment.
#
# Overrides for museum, Ente's API server. Anything not set here falls back to
# the defaults baked into the image (server/configurations/local.yaml upstream).
{% set _s = infisical_secrets.secrets %}
{% set _names = _service_config.ente.dns_names %}

db:
    host: ente-postgres
    port: 5432
    name: ente_db
    user: pguser
    password: "{{ _s.ENTE_DB_PASSWORD }}"

# Object storage: a single external S3 bucket (Cloudflare R2). The key name
# "b2-eu-cen" is fixed by museum for historical reasons — it is simply the
# primary hot storage slot and says nothing about the provider. Replication is
# off, so the other slots are left unset.
s3:
    are_local_buckets: false
    use_path_style_urls: true
    b2-eu-cen:
        key: "{{ _s.ENTE_S3_ACCESS_KEY }}"
        secret: "{{ _s.ENTE_S3_SECRET_KEY }}"
        endpoint: "{{ _s.ENTE_S3_ENDPOINT }}"
        region: auto
        bucket: "{{ _s.ENTE_S3_BUCKET }}"

apps:
    public-albums: https://{{ _names[3] }}.{{ server_domain }}
    accounts: https://{{ _names[2] }}.{{ server_domain }}

webauthn:
    rpid: {{ _names[2] }}.{{ server_domain }}
    rporigins:
        - "https://{{ _names[2] }}.{{ server_domain }}"

key:
    encryption: "{{ _s.ENTE_KEY_ENCRYPTION }}"
    hash: "{{ _s.ENTE_KEY_HASH }}"

jwt:
    secret: "{{ _s.ENTE_JWT_SECRET }}"

{% if 'ENTE_SMTP_USERNAME' in _s and 'ENTE_SMTP_PASSWORD' in _s and 'ENTE_SMTP_FROM' in _s %}
# Login codes are emailed through SMTP2GO. Without this block museum only
# writes them to its log.
smtp:
    host: mail.smtp2go.com
    port: 587
    username: "{{ _s.ENTE_SMTP_USERNAME }}"
    password: "{{ _s.ENTE_SMTP_PASSWORD }}"
    email: "{{ _s.ENTE_SMTP_FROM }}"
    sender-name: "Swintronics Photos"
{% endif %}

internal:
    # Set ente_disable_registration: true in host_vars to stop new sign-ups;
    # existing accounts and shared-album links keep working.
    disable-registration: {{ ente_disable_registration | default(false) | bool | lower }}
