# Managed by Ansible. Do not edit — changes will be overwritten on next deployment.
#
# Hawser (https://github.com/Finsys/hawser) — Dockhand's agent, in edge mode:
# it dials out to the Dockhand instance on the main server over the tailnet, so
# this host shows up there as a second environment. Nothing listens for
# inbound connections and there is no UI here. Written from upstream's
# `docker run` example (upstream publishes no compose file).

name: hawser

services:
  hawser:
    image: ghcr.io/finsys/hawser:{{ versions.hawser }}
    container_name: hawser
    restart: always
    env_file: .env
    # Host networking so the agent reaches Dockhand's tailnet address directly.
    # In edge mode its only listener is the health endpoint; keep it on loopback.
    network_mode: host
    environment:
      DOCKHAND_SERVER_URL: "wss://{{ _service_config.dockhand.dns_names[0] }}.{{ server_domain }}/api/hawser/connect"
      AGENT_NAME: "{{ dns_hostname }}"
      BIND_ADDRESS: 127.0.0.1
      # Must be the same path inside and outside the container: the Docker
      # daemon resolves a stack's relative bind mounts on the host.
      STACKS_DIR: {{ data_disk_mountpoint }}/volumes/hawser/stacks
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ data_disk_mountpoint }}/volumes/hawser/stacks:{{ data_disk_mountpoint }}/volumes/hawser/stacks
    labels:
      autoheal: "true"
