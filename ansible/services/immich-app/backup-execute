#!/bin/bash
set -euo pipefail
# Stop immich, dump postgres, snapshot library volume, restart immich.
# The healthchecks.io heartbeat is paused by the orchestrator during this phase.

DATA="${DATA_MOUNTPOINT:-/mnt/docker-data}"
SOURCE="${DATA}/volumes/immich/library"
SNAP_DIR="${DATA}/snapshots/immich/library/backup"
# Write the dump where immich's restore UI looks (UPLOAD_LOCATION/backups), named
# like its own dumps so it shows the version-compatibility badge. The swintronics-
# prefix keeps it out of immich's retention cleanup (immich-db-backup-* only).
BACKUPS_DIR="${SOURCE}/backups"
DUMP_PREFIX="swintronics-db-backup-"

mkdir -p "$(dirname "${SNAP_DIR}")"

# Clean up previous backup snapshot
if [ "$(stat --format=%i "${SNAP_DIR}" 2>/dev/null)" = "256" ]; then
    sudo btrfs property set "${SNAP_DIR}" ro false
    sudo btrfs subvolume delete "${SNAP_DIR}"
fi
if [ -e "${SNAP_DIR}" ]; then
    echo "ERROR: could not remove previous snapshot at ${SNAP_DIR}" >&2; exit 1
fi

# Read the server version before stopping it
IMMICH_VERSION=$(docker compose exec -T immich-server node -p "require('/usr/src/app/server/package.json').version")

echo "Stopping Immich services..."
docker compose stop immich-server immich-machine-learning

echo "Dumping Immich database..."
docker compose up -d database
PG_VERSION=$(docker compose exec -T database sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SHOW server_version"' | cut -d' ' -f1)
DB_DUMP="${BACKUPS_DIR}/${DUMP_PREFIX}$(date +%Y%m%dT%H%M%S)-v${IMMICH_VERSION}-pg${PG_VERSION}.sql.gz"
docker compose exec -T database sh -c 'pg_dump --clean --if-exists -U "$POSTGRES_USER" -d "$POSTGRES_DB"' \
    | gzip > "${DB_DUMP}.tmp"
mv "${DB_DUMP}.tmp" "${DB_DUMP}"

# Keep only the newest dump; restic holds the history
find "${BACKUPS_DIR}" -maxdepth 1 -name "${DUMP_PREFIX}*.sql.gz" ! -path "${DB_DUMP}" -delete
# Legacy pg_dumpall location (pre-restore-UI format)
rm -f "${SOURCE}/immich_db.sql"

echo "Creating btrfs snapshot at ${SNAP_DIR}..."
sudo btrfs subvolume snapshot -r "${SOURCE}" "${SNAP_DIR}"

echo "Starting Immich services..."
docker compose start immich-server immich-machine-learning
