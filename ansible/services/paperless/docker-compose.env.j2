# Managed by Ansible. Do not edit — changes will be overwritten on next deployment.

PAPERLESS_URL=https://{{ _service_config.paperless.dns_names[0] }}.{{ server_domain }}
PAPERLESS_SECRET_KEY={{ infisical_secrets.secrets.PAPERLESS_SECRET_KEY }}
USERMAP_UID=1000
USERMAP_GID=1001

# v3 allows duplicates by default and only flags them in the UI.
# Restore the v2 behaviour of rejecting them at consume time.
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true
{% if paperless_remote_ocr_key is defined and paperless_remote_ocr_key %}

# Optional Azure AI Document Intelligence OCR. Inert unless both
# PAPERLESS_REMOTE_OCR_* secrets exist in Infisical. workflow_only is
# deliberate: the paperless default is "always", which would route every
# document to Azure.
PAPERLESS_REMOTE_OCR_ENGINE=azureai
PAPERLESS_REMOTE_OCR_API_KEY={{ paperless_remote_ocr_key }}
PAPERLESS_REMOTE_OCR_ENDPOINT={{ paperless_remote_ocr_endpoint }}
PAPERLESS_REMOTE_OCR_MODE=workflow_only
{% endif %}
